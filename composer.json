{
    "name": "baywa-re-lusy/users-api-sdk",
    "description": "BayWa r.e. LUSY Users API SDK",
    "type": "library",
    "license": "proprietary",
    "homepage": "https://github.com/baywa-re-lusy/users-api-sdk",
    "require": {
        "php": ">= 8.2",
        "ext-curl": "*",
        "psr/cache": "^1.0 || ^2.0 || ^3.0",
        "psr/log": "^3.0",
        "psr/http-client": "^1.0",
        "psr/http-message": "^2.0",
        "laminas/laminas-diactoros": "^3.3",
        "symfony/console": "^6.4 || v7.0",
        "laminas/laminas-permissions-acl": "^2.16",
        "laminas/laminas-hydrator": "^4.15",
        "laminas/laminas-validator": "^2.0",
        "baywa-re-lusy/user-subsidiary-model": "^1.0"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.7",
        "phpstan/phpstan": "^1.9",
        "phpunit/phpunit": "^10.0",
        "guzzlehttp/guzzle": "^7.5",
        "ramsey/uuid": "^4.7",
        "behat/behat": "^3.14",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
